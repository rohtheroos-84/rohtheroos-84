{
  "headers": [
    {
      "source": "/api/views",
      "headers": [
        { "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "image/svg+xml" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=1800, stale-while-revalidate" },
        { "key": "Content-Type", "value": "image/svg+xml" }
      ]
    }
  ]
}
